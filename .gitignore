# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual Environment ────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── 🔐 SECRETS — NEVER COMMIT ──────────────────────────────────
.env
.env.*
!.env.example

# ── Jarvis config with secrets ─────────────────────────────────
